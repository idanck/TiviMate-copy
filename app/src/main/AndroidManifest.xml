<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- docs/07 section 7.9: streaming, the recorder's foreground service, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- ADR-015: the Android Auto radio session's foreground promotion. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app updates (FR-UPD-04): the app is distributed outside a store, so it installs
         its own updates. UPDATE_PACKAGES_WITHOUT_USER_ACTION is a normal permission that lets
         a self-update skip the confirmation once this app is the installer of record. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Google TV "Continue watching" (FR-TVI-02). Declared because the platform documents it
         for apps writing Watch Next rows; on a device where it is not granted, the writes in
         tv/WatchNextSync.kt fail and are swallowed, which costs a launcher row and nothing else. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- The home screen's app shortcuts (FR-UI-28, ADR-020). Android 11 hides other packages
         from us unless they are declared here, so this list mirrors `ui/home/HomeApps.CATALOGUE`
         exactly: a package missing from it is invisible even when it is installed, and the
         shortcut silently never appears. Declared one by one rather than as a LEANBACK_LAUNCHER
         intent filter, which would ask the platform for every launchable app on the box to read
         a list of nine. -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.apple.atve.android.appletv" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.spotify.music" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.cellcom.cellcom_tv" />
    </queries>

    <!-- One binary for both form factors: neither leanback nor a touchscreen is required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiviCopy"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- ADR-015: sideload-only Android Auto support, tested via Auto's own "Unknown
             sources" developer setting rather than Play Store review. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.TiviCopy">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- The TV launcher only shows activities carrying this category. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Launcher deep links (FR-TVI-04): a card in Google TV's "Continue watching" row
                 carries shidur://channel/<id> and lands here.

                 A separate filter, deliberately: an intent matches only when *every* category
                 in the filter matches, so folding VIEW/BROWSABLE into the launcher filter above
                 would stop the app appearing on the home screen at all.

                 A custom scheme rather than an https App Link because this app owns no web
                 domain whose links it should be intercepting. The reachable surface is one
                 action — play a channel already in this device's own database. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shidur" android:host="channel" />
            </intent-filter>
        </activity>

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps a radio station playing behind a locked screen (see RadioBackgroundService);
             started/stopped by MainActivity, never bound to from outside the app. -->
        <service
            android:name=".player.RadioBackgroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ADR-015: browsable/playable from Android Auto's media template. Exported because the
             car host process binds to it from outside this app. -->
        <service
            android:name=".auto.RadioMediaLibraryService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".record.RecordingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tivicopy.player.record.ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".record.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Replacing the package clears its alarms; the schedule is re-armed. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Addressed by class from the installer session's PendingIntent, so it needs no
             intent filter and is never reachable from outside the app. -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

    </application>
</manifest>
