<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages this build actually ships, matching `resourceConfigurations` in the build file.
  Declaring them lets Android 13 and later list the app under the system per-app language setting.
  That setting changes the locale the platform hands us, which the in-app picker's default
  (AppLanguage.SYSTEM) follows; picking a language in the app overrides it (FR-UI-23, ADR-009).
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="he" />
</locale-config>
