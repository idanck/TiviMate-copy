{
  "name": "shidur-webos",
  "private": true,
  "description": "Shidur for LG televisions (webOS 6 and later): a packaged web app and the JS service it reads providers through.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@webos-tools/cli": "3.2.6",
    "acorn": "8.15.0",
    "postcss": "8.5.30",
    "postcss-preset-env": "11.6.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
