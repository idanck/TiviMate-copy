{
  "name": "shidur-web",
  "private": true,
  "description": "Shidur for the computer: an installable web app (PWA) and the small server it needs. `dependencies` are the server's, at run time; the browser's libraries are bundled at build time and are devDependencies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@preact/signals": "2.11.3",
    "@types/node": "22.20.5",
    "concurrently": "9.2.1",
    "firebase": "13.2.0",
    "hls.js": "1.6.19",
    "mpegts.js": "1.8.2",
    "preact": "10.29.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
