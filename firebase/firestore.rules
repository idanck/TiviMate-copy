rules_version = '2';

// Shidur's Firestore (ADR-059). Clients read; only Cloud Functions and the console write.
service cloud.firestore {
  match /databases/{database}/documents {

    // Switches the owner flips in the console, read before anyone signs in: `config/app` holds
    // `requireSignIn`. A missing document means every switch is off.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // An account's own document: `createdAt`, `displayName`, `entitlements`. Created by the
    // ensureProfile function; `entitlements` is written only by Functions or by hand in the
    // console, so no client write is allowed here at all.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Television pairing codes and rate-limit counters belong to the Functions alone.
    match /pairings/{code} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // YouTube (ADR-061): the shared channel and search caches, the day's quota counters, the
    // connections waiting for a code and the accounts' YouTube tokens. The Functions' alone: the app
    // gets what it draws from the callables, and no client may ever read a token.
    match /ytChannels/{id} {
      allow read, write: if false;
    }
    match /ytSearch/{id} {
      allow read, write: if false;
    }
    match /ytQuota/{day} {
      allow read, write: if false;
    }
    match /ytLinks/{uid} {
      allow read, write: if false;
    }
    match /ytTokens/{uid} {
      allow read, write: if false;
    }
    match /ytSubs/{uid} {
      allow read, write: if false;
    }

    // Podcast Index (ADR-067): the shared cache of searches and the popular rail. The Functions' alone.
    match /pcCache/{id} {
      allow read, write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
