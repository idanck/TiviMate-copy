rules_version = '2';

// Shidur's Firestore (ADR-059). Clients read; only Cloud Functions and the console write — except an
// account's own podcast library, marks and queue (ADR-067), and its music likes, saved albums and
// listening history (ADR-069), below.
service cloud.firestore {
  match /databases/{database}/documents {

    // Switches the owner flips in the console, read before anyone signs in: `config/app` holds
    // `requireSignIn`. A missing document means every switch is off.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // An account's own document: `createdAt`, `displayName`, `entitlements`. Created by the
    // ensureProfile function; `entitlements` is written only by Functions or by hand in the
    // console, so no client write is allowed here at all.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Podcasts (ADR-067): the one place a client writes. An account's own library, marks and
    // queue, each of a bounded size and of the fields the app writes, so the documents can be
    // nothing but what they are for.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function feedOk(d) {
      return d.feedUrl is string && d.feedUrl.size() > 0 && d.feedUrl.size() <= 2048 && d.updatedUtc is int;
    }
    match /users/{uid}/podcasts/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && feedOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['feedUrl', 'title', 'inLibrary', 'speed', 'skipIntroSeconds',
             'skipOutroSeconds', 'notifyNew', 'oldestFirst', 'updatedUtc'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.inLibrary is bool;
    }
    match /users/{uid}/podcastMarks/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && feedOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['feedUrl', 'guid', 'positionMs', 'durationMs', 'played', 'favourite',
             'favouriteUtc', 'historyUtc', 'lastPlayedUtc', 'device', 'updatedUtc'])
        && request.resource.data.guid is string && request.resource.data.guid.size() <= 2048
        && request.resource.data.positionMs is int && request.resource.data.played is bool
        && request.resource.data.favourite is bool;
    }
    match /users/{uid}/podcastState/{doc} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && doc == 'queue'
        && request.resource.data.keys().hasOnly(['keys', 'updatedUtc'])
        && request.resource.data['keys'] is list && request.resource.data['keys'].size() <= 200
        && request.resource.data.updatedUtc is int;
    }

    // YouTube Music (ADR-069): what the official YouTube API does not give, kept by Shidur for the
    // account — the songs it liked in Shidur, the albums it saved, and what it played. Each of the
    // fields the app writes, of a bounded size; the app trims the history itself.
    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }
    function optStr(v, max) {
      return v == null || shortStr(v, max);
    }
    function optInt(v) {
      return v == null || v is int;
    }
    function trackOk(d) {
      return shortStr(d.videoId, 64) && d.videoId.size() > 0 && shortStr(d.title, 300)
        && optStr(d.get('artist', null), 200) && optStr(d.get('channelId', null), 64)
        && optStr(d.get('thumb', null), 2048) && optInt(d.get('duration', null)) && d.updatedUtc is int;
    }
    match /users/{uid}/musicLikes/{videoId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && trackOk(request.resource.data)
        && request.resource.data.videoId == videoId
        && request.resource.data.keys().hasOnly(['videoId', 'title', 'artist', 'channelId', 'thumb', 'duration', 'likedUtc', 'updatedUtc'])
        && request.resource.data.likedUtc is int;
    }
    match /users/{uid}/musicAlbums/{listId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['listId', 'title', 'artist', 'thumb', 'count', 'savedUtc', 'updatedUtc'])
        && request.resource.data.listId == listId && shortStr(listId, 64)
        && shortStr(request.resource.data.title, 300) && optStr(request.resource.data.get('artist', null), 200)
        && optStr(request.resource.data.get('thumb', null), 2048) && optInt(request.resource.data.get('count', null))
        && request.resource.data.savedUtc is int && request.resource.data.updatedUtc is int;
    }
    match /users/{uid}/musicHistory/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && shortStr(id, 100) && trackOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['videoId', 'title', 'artist', 'channelId', 'thumb', 'duration', 'playedUtc',
             'positionMs', 'device', 'context', 'updatedUtc'])
        && request.resource.data.playedUtc is int && optInt(request.resource.data.get('positionMs', null))
        && request.resource.data.device in ['tv', 'phone'] && optStr(request.resource.data.get('context', null), 64);
    }

    // Television pairing codes and rate-limit counters belong to the Functions alone.
    match /pairings/{code} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // YouTube (ADR-061): the shared channel and search caches, the day's quota counters, the
    // connections waiting for a code and the accounts' YouTube tokens. The Functions' alone: the app
    // gets what it draws from the callables, and no client may ever read a token.
    match /ytChannels/{id} {
      allow read, write: if false;
    }
    match /ytSearch/{id} {
      allow read, write: if false;
    }
    match /ytQuota/{day} {
      allow read, write: if false;
    }
    match /ytLinks/{uid} {
      allow read, write: if false;
    }
    match /ytTokens/{uid} {
      allow read, write: if false;
    }
    match /ytSubs/{uid} {
      allow read, write: if false;
    }

    // YouTube Music's caches (ADR-069): the music category and chart, playlists and albums, and an
    // account's library as read from YouTube. The Functions' alone.
    match /ytMusic/{id} {
      allow read, write: if false;
    }
    match /ytmPlaylists/{id} {
      allow read, write: if false;
    }
    match /ytmLib/{uid} {
      allow read, write: if false;
    }

    // Podcast Index (ADR-067): the shared cache of searches and the popular rail. The Functions' alone.
    match /pcCache/{id} {
      allow read, write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
